{
  "name": "one-site-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ng": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "deploy:ubuntu": "git fetch origin && git pull && npm install && ng build --configuration production && sudo rm -rf /var/www/onesiteweb/* && sudo cp -r dist/OneSiteWeb/* /var/www/onesiteweb/",
    "deploy:amazon": "git fetch origin && git pull && npm install && ng build --configuration production && sudo rm -rf /usr/share/nginx/html/onesite/* && sudo cp -r dist/OneSiteWeb/* /usr/share/nginx/html/onesite"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "piscina": "^5.3.2"
  },
  "dependencies": {
    "@angular/animations": "^20.3.33",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@popperjs/core": "^2.11.8",
    "@preline/overlay": "^3.2.3",
    "@tailwindcss/postcss": "^4.1.10",
    "bootstrap": "^5.3.6",
    "docx-preview": "^0.3.7",
    "docxtemplater": "^3.71.0",
    "flowbite": "^4.0.1",
    "lucide-angular": "^0.548.0",
    "ngx-toastr": "^19.0.0",
    "pagedjs": "^0.4.3",
    "pizzip": "^3.3.0",
    "postcss": "^8.5.28",
    "preline": "^3.2.3",
    "rxjs": "~7.8.0",
    "sortablejs": "^1.15.6",
    "tailwindcss": "^4.1.10",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.33",
    "@playwright/test": "^1.63.0",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/sortablejs": "^1.15.8",
    "jasmine-core": "~5.7.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
